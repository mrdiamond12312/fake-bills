{
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist",
  "build": {
    "env": {
      "ENABLE_FILE_SYSTEM_API": "1"
    }
  },
  "functions": {
    "api/bills/render.js": {
      "includeFiles": "node_modules/{satori,@shuding,@resvg,yoga-wasm-web,css-*,emoji-regex,escape-html,linebreak,unicode-trie,tiny-inflate,base64-js,parse-css-color,hex-rgb,postcss-value-parser,camelize,color-name,string.prototype.codepointat,fflate,bwip-js}/**"
    }
  }
}
