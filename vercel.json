{
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist",
  "build": {
    "env": {
      "ENABLE_FILE_SYSTEM_API": "1"
    }
  },
  "functions": {
    "api/bills/render.js": {
      "includeFiles": "node_modules/{satori,@shuding,yoga-wasm-web,css-background-parser,css-box-shadow,css-to-react-native,camelize,css-color-keywords,color-name,emoji-regex,escape-html,linebreak,unicode-trie,tiny-inflate,base64-js,parse-css-color,hex-rgb,postcss-value-parser,string.prototype.codepointat,fflate,bwip-js,@resvg}/**"
    }
  }
}
